#!/bin/sh
#
# Bloque la mise en ligne accidentelle d'identifiants.
#
# Execute par le sh fourni avec Git for Windows : fonctionne aussi bien en
# PowerShell qu'avec GitHub Desktop. Ce fichier doit rester en fins de ligne LF
# (voir .gitattributes) : en CRLF, Windows echoue avec "bad interpreter".
#
# Active par : git config core.hooksPath .githooks
# Contournement ponctuel et assume : git commit --no-verify

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

say() { printf '%s\n' "$1" >&2; }

# Faux positifs connus : valeurs de modele, et variables qui designent un
# CHEMIN ou une URL plutot qu'un secret (YUKI_API_KEYS_FILE=/chemin/...).
IGNORE='api-key-for-admin|your-api-key|xxx-xxx|placeholder|example|changeme|_FILE[[:space:]]*=|_PATH[[:space:]]*=|_URL[[:space:]]*=|/path/to'

# ── 1. Fichiers qui ne doivent jamais etre suivis ────────────────────────────
for f in $staged; do
  case "$f" in
    .env.example) : ;;                        # modele sans valeurs : autorise
    .env|.env.*|*/.env|*/.env.*)
      say "BLOQUE  $f : fichier d'environnement (contient des cles)"; fail=1 ;;
    *api-keys*.json|*.pem|*.key|*.p12|*.pfx|id_rsa*|.yuki_session.json)
      say "BLOQUE  $f : fichier d'identifiants ou de session"; fail=1 ;;
    *.csv|*.xlsx|*.xls)
      say "BLOQUE  $f : donnees comptables clientes, hors perimetre de ce depot"; fail=1 ;;
  esac
done

# ── 2. Contenu : cle renseignee dans un fichier suivi ────────────────────────
# On inspecte le contenu mis en scene (index), pas le fichier du disque : c'est
# ce qui partirait reellement sur GitHub.
for f in $staged; do
  case "$f" in
    *.png|*.jpg|*.pdf|*.ico|package-lock.json) continue ;;
  esac
  blob=$(git show ":$f" 2>/dev/null) || continue

  # Valeur litterale ENTRE GUILLEMETS affectee a une variable de type cle.
  # Exiger les guillemets evite de bloquer du code legitime comme
  #   const apiKey = this.apiKeyMap.get(adminId) ?? this.apiKey;
  echo "$blob" | grep -nEi '(API_?KEY|ACCESS_?KEY|SECRET|PASSWORD|TOKEN)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*["'"'"'][A-Za-z0-9_/+=-]{16,}["'"'"']' \
    | grep -vEi "$IGNORE" \
    && { say "BLOQUE  $f : cle litterale renseignee (ligne ci-dessus)"; fail=1; }

  # Valeur non entre guillemets : uniquement dans les fichiers de configuration
  # et de documentation, ou la forme CLE=valeur est la norme. Exclure le code
  # source evite les faux positifs sur les acces aux proprietes.
  case "$f" in
    *.md|*.txt|*.yml|*.yaml|*.json|*.example|*.ps1|*.cmd|*.bat|*.ini|*.cfg)
      # Pas de "/" dans la valeur : un chemin n'est pas un secret, une cle Yuki
      # (GUID) et une cle Anthropic n'en contiennent pas.
      echo "$blob" | grep -nEi '^[[:space:]]*[A-Z_]*(API_?KEY|ACCESS_?KEY|SECRET|PASSWORD|TOKEN)[A-Z_]*[[:space:]]*=[[:space:]]*[A-Za-z0-9_+=.-]{16,}[[:space:]]*$' \
        | grep -vEi "$IGNORE" \
        && { say "BLOQUE  $f : cle renseignee dans un fichier de configuration"; fail=1; } ;;
  esac

  # GUID entre guillemets. Une cle API Yuki et un administrationID sont des GUID :
  # un GUID en dur dans un fichier suivi est presume etre un identifiant reel.
  echo "$blob" | grep -nE '["'"'"'][0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}["'"'"']' \
    | grep -vEi 'a1b2c3d4|00000000-0000|12345678|xxxxxxxx|deadbeef|11111111' \
    && { say "BLOQUE  $f : GUID en dur, probablement une cle ou un administrationID"; fail=1; }

  # Cle Anthropic
  echo "$blob" | grep -nE 'sk-ant-[A-Za-z0-9_-]{16,}' \
    && { say "BLOQUE  $f : cle API Anthropic"; fail=1; }

  # GUID associe a une cle dans un mapping administrationId -> apiKey
  echo "$blob" | grep -nE '"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"[[:space:]]*:[[:space:]]*"[^"]{12,}"' \
    | grep -v 'a1b2c3d4-0000' \
    && { say "BLOQUE  $f : correspondance administrationID -> cle"; fail=1; }
done

if [ "$fail" -ne 0 ]; then
  say ""
  say "Commit interrompu : des identifiants seraient partis sur GitHub."
  say "Retirer le fichier de l'index :  git restore --staged <fichier>"
  say "Si c'est un faux positif :        git commit --no-verify"
  exit 1
fi

exit 0
