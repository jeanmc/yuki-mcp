# Yuki API key — found in Yuki under Settings > API
# Optional when using a per-administration keys file (see YUKI_API_KEYS_FILE).
YUKI_API_KEY=

# The administration/domain ID to use by default (GUID from get_administrations)
YUKI_DOMAIN_ID=

# Path to a JSON file mapping administrationId -> apiKey, so one server can
# serve several client files, each with its own revocable key.
# Defaults to ~/.yuki/api-keys.json when unset.
YUKI_API_KEYS_FILE=

# Yuki endpoint. Defaults to Belgium (.be) in this fork.
# Use https://api.yukiworks.nl/ws/ for a Dutch administration.
#
# WARNING: VAT codes and GL account numbers are country-specific. Pointing a
# Belgian file at the .nl host does not raise an error, it produces wrong
# bookings. Set this deliberately per environment.
YUKI_BASE_URL=https://api.yukiworks.be/ws/

# Write tools (process_journal, process_sales_invoice, process_purchase_invoice,
# upsert_contact, upload_document) are DISABLED by default: they post into live
# client accounting records. Set to true only on an instance where that is
# intended, and preferably not the one used for routine reading.
YUKI_ENABLE_WRITE_TOOLS=false

# Anthropic API key — only required for the test-agent script (npm run agent)
ANTHROPIC_API_KEY=
